{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": ".."
  },
  "include": ["**/*.ts", "../shared/**/*.ts", "../orchestrator/**/*.ts"]
}
